# Runs against Shopify's public mock.shop Storefront API.
# No Shopify account, no API token, no dev store required.
PUBLIC_STORE_DOMAIN="mock.shop"

# Local MiniOxygen session signing key. Not a secret in this project.
SESSION_SECRET="shopify-headless-perf-lab-local-dev"

# "optimized" (default) or "baseline".
# baseline deliberately reproduces the render-blocking patterns of a typical
# app-heavy Liquid theme so the two can be measured side by side.
# See docs/adr/0003-baseline-vs-optimized-perf-modes.md
PERF_MODE="optimized"
